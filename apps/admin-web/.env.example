# Same-origin API. The local launcher forwards /api to the existing data service.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:3001
# Public DEMO_FIXTURE organization selector; replace for your organization.
VITE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# Development only. Never enable for a deployed build.
VITE_LOCAL_SHORT_PASSWORDS=0
