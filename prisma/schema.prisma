generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("organization_status")
}

enum UserStatus {
  ACTIVE
  FROZEN
  DELETED

  @@map("user_status")
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LEFT

  @@map("membership_status")
}

enum Role {
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  TOURNAMENT_ADMIN
  TEAM_CAPTAIN
  MATCH_REPORTER
  OFFICIAL
  REVIEWER

  @@map("role")
}

enum RoleScopeType {
  PLATFORM
  ORGANIZATION
  TOURNAMENT
  TEAM
  MATCH

  @@map("role_scope_type")
}

enum AuditActorType {
  USER
  MATCH_REPORTER
  OFFICIAL
  ADMIN
  SYSTEM
  WORKER
  IMPORT_BATCH
  EMERGENCY_SQL

  @@map("audit_actor_type")
}

enum OutboxJobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED_RETRYABLE
  FAILED_PERMANENT
  CANCELLED

  @@map("outbox_job_status")
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("tournament_status")
}

enum CompetitionRuleVersionStatus {
  PUBLISHED
  RETIRED

  @@map("competition_rule_version_status")
}

enum StageType {
  GROUP
  KNOCKOUT

  @@map("stage_type")
}

enum SchedulePlanStatus {
  DRAFT
  PUBLISHED
  CANCELLED

  @@map("schedule_plan_status")
}

enum ScheduleRevisionStatus {
  PUBLISHED

  @@map("schedule_revision_status")
}

enum MatchStatus {
  DRAFT
  SCHEDULED
  LIVE
  FINISHED
  POSTPONED
  CANCELLED

  @@map("match_status")
}

enum TeamRegistrationStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
  WITHDRAWN
  SUSPENDED

  @@map("team_registration_status")
}

enum RosterSubmissionStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  LOCKED
  REOPENED
  WITHDRAWN

  @@map("roster_submission_status")
}

enum DataQualityStatus {
  CLEAN
  WARNING
  ERROR

  @@map("data_quality_status")
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  READY
  IMPORTING
  SUCCEEDED
  FAILED
  CANCELLED

  @@map("import_batch_status")
}

model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  slug               String                   @unique(map: "organizations_slug_key") @db.VarChar(64)
  name               String                   @db.VarChar(120)
  status             OrganizationStatus       @default(ACTIVE)
  createdAt          DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships        OrganizationMembership[]
  roleAssignments    RoleAssignment[]
  auditLogs          AuditLog[]
  idempotencyRecords IdempotencyRecord[]
  outboxJobs         OutboxJob[]
  seasons            Season[]
  tournaments        Tournament[]
  teams              Team[]
  playerProfiles     PlayerProfile[]
  venues             Venue[]
  schedulePlans      SchedulePlan[]
  scheduleRevisions  ScheduleRevision[]
  matches            Match[]
  teamRegistrations  TeamRegistration[]
  rosterSubmissions  RosterSubmission[]
  rosterEntries      RosterEntry[]
  rosterSnapshots    RosterSnapshot[]
  snapshotEntries    RosterSnapshotEntry[]
  importBatches      ImportBatch[]

  @@map("organizations")
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  loginNameNormalized String?                  @map("login_name_normalized") @db.VarChar(120)
  displayName         String                   @map("display_name") @db.VarChar(120)
  status              UserStatus               @default(ACTIVE)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships         OrganizationMembership[]
  wechatIdentities    WechatIdentity[]
  sessions            UserSession[]
  roleAssignments     RoleAssignment[]         @relation("RoleAssignmentUser")
  grantedAssignments  RoleAssignment[]         @relation("RoleAssignmentGrantor")
  auditLogs           AuditLog[]
  idempotencyRecords  IdempotencyRecord[]

  @@map("app_users")
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(PENDING)
  joinedAt       DateTime?        @map("joined_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId], map: "organization_memberships_organization_id_user_id_key")
  @@index([organizationId, status], map: "organization_memberships_organization_id_status_idx")
  @@index([userId, status], map: "organization_memberships_user_id_status_idx")
  @@map("organization_memberships")
}

model WechatIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  provider  String   @default("WECHAT") @db.VarChar(32)
  openid    String   @db.VarChar(128)
  unionid   String?  @db.VarChar(128)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, openid], map: "wechat_identities_provider_openid_key")
  @@index([userId], map: "wechat_identities_user_id_idx")
  @@map("wechat_identities")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "user_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.VarChar(128)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(3)
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "user_sessions_user_id_revoked_at_expires_at_idx")
  @@map("user_sessions")
}

model RoleAssignment {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String?       @map("organization_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  role            Role
  scopeType       RoleScopeType @map("scope_type")
  scopeId         String        @map("scope_id") @db.VarChar(64)
  grantedByUserId String?       @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime      @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(3)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user            User          @relation("RoleAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedByUser   User?         @relation("RoleAssignmentGrantor", fields: [grantedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, role, scopeType, scopeId], map: "role_assignments_user_id_role_scope_type_scope_id_key")
  @@index([organizationId, revokedAt], map: "role_assignments_organization_id_revoked_at_idx")
  @@index([userId, revokedAt], map: "role_assignments_user_id_revoked_at_idx")
  @@map("role_assignments")
}

model AuditLog {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  actorType         AuditActorType @map("actor_type")
  actorUserId       String?        @map("actor_user_id") @db.Uuid
  actorRoleSnapshot Json?          @map("actor_role_snapshot") @db.JsonB
  action            String         @db.VarChar(120)
  targetType        String         @map("target_type") @db.VarChar(120)
  targetId          String         @map("target_id") @db.VarChar(128)
  beforeSummary     Json?          @map("before_summary") @db.JsonB
  afterSummary      Json?          @map("after_summary") @db.JsonB
  reason            String?        @db.VarChar(500)
  requestId         String         @map("request_id") @db.VarChar(128)
  correlationId     String?        @map("correlation_id") @db.VarChar(128)
  ipAddress         String?        @map("ip_address") @db.Inet
  userAgent         String?        @map("user_agent") @db.VarChar(512)
  source            String         @db.VarChar(64)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser         User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, targetType, targetId, createdAt], map: "audit_logs_organization_id_target_type_target_id_created_at_idx")
  @@index([requestId], map: "audit_logs_request_id_idx")
  @@map("audit_logs")
}

model IdempotencyRecord {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  route          String        @db.VarChar(200)
  idempotencyKey String        @map("idempotency_key") @db.VarChar(128)
  requestHash    String        @map("request_hash") @db.Char(64)
  responseStatus Int?          @map("response_status")
  responseBody   Json?         @map("response_body") @db.JsonB
  resourceType   String?       @map("resource_type") @db.VarChar(120)
  resourceId     String?       @map("resource_id") @db.VarChar(128)
  expiresAt      DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, route, idempotencyKey], map: "idempotency_records_user_id_route_idempotency_key_key")
  @@index([organizationId, createdAt], map: "idempotency_records_organization_id_created_at_idx")
  @@index([expiresAt], map: "idempotency_records_expires_at_idx")
  @@map("idempotency_records")
}

model OutboxJob {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String?         @map("organization_id") @db.Uuid
  topic            String          @db.VarChar(120)
  aggregateType    String          @map("aggregate_type") @db.VarChar(120)
  aggregateId      String          @map("aggregate_id") @db.VarChar(128)
  eventType        String          @map("event_type") @db.VarChar(120)
  payload          Json            @db.JsonB
  deduplicationKey String?         @map("deduplication_key") @db.VarChar(200)
  correlationId    String?         @map("correlation_id") @db.VarChar(128)
  status           OutboxJobStatus @default(PENDING)
  attemptCount     Int             @default(0) @map("attempt_count")
  maxAttempts      Int             @default(10) @map("max_attempts")
  availableAt      DateTime        @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt         DateTime?       @map("locked_at") @db.Timestamptz(3)
  lockedUntil      DateTime?       @map("locked_until") @db.Timestamptz(3)
  lockedBy         String?         @map("locked_by") @db.VarChar(120)
  processedAt      DateTime?       @map("processed_at") @db.Timestamptz(3)
  lastErrorCode    String?         @map("last_error_code") @db.VarChar(120)
  lastError        String?         @map("last_error") @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization?   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([status, availableAt], map: "outbox_jobs_status_available_at_idx")
  @@index([lockedUntil], map: "outbox_jobs_locked_until_idx")
  @@index([correlationId], map: "outbox_jobs_correlation_id_idx")
  @@index([organizationId, createdAt], map: "outbox_jobs_organization_id_created_at_idx")
  @@map("outbox_jobs")
}

model Season {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  seasonCode     String       @map("season_code") @db.VarChar(64)
  name           String       @db.VarChar(120)
  startsOn       DateTime?    @map("starts_on") @db.Date
  endsOn         DateTime?    @map("ends_on") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournaments    Tournament[]

  @@unique([organizationId, seasonCode], map: "seasons_organization_id_season_code_key")
  @@index([organizationId, createdAt], map: "seasons_organization_id_created_at_idx")
  @@map("seasons")
}

model Tournament {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  seasonId          String                   @map("season_id") @db.Uuid
  tournamentCode    String                   @map("tournament_code") @db.VarChar(64)
  name              String                   @db.VarChar(160)
  status            TournamentStatus         @default(DRAFT)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  season            Season                   @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  ruleVersions      CompetitionRuleVersion[]
  stages            Stage[]
  schedulePlans     SchedulePlan[]
  scheduleRevisions ScheduleRevision[]
  matches           Match[]
  teamRegistrations TeamRegistration[]
  rosterSnapshots   RosterSnapshot[]
  importBatches     ImportBatch[]

  @@unique([organizationId, tournamentCode], map: "tournaments_organization_id_tournament_code_key")
  @@unique([id, organizationId], map: "tournaments_id_organization_id_key")
  @@index([organizationId, status, createdAt], map: "tournaments_organization_id_status_created_at_idx")
  @@index([seasonId], map: "tournaments_season_id_idx")
  @@map("tournaments")
}

model CompetitionRuleVersion {
  id             String                       @id @default(uuid()) @db.Uuid
  organizationId String                       @map("organization_id") @db.Uuid
  tournamentId   String                       @map("tournament_id") @db.Uuid
  version        Int
  name           String                       @db.VarChar(120)
  status         CompetitionRuleVersionStatus @default(PUBLISHED)
  rules          Json                         @db.JsonB
  publishedAt    DateTime                     @default(now()) @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tournament     Tournament                   @relation(fields: [tournamentId], references: [id], onDelete: Restrict)

  @@unique([tournamentId, version], map: "competition_rule_versions_tournament_id_version_key")
  @@index([organizationId, tournamentId], map: "competition_rule_versions_organization_id_tournament_id_idx")
  @@map("competition_rule_versions")
}

model Stage {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  tournamentId   String             @map("tournament_id") @db.Uuid
  stageCode      String             @map("stage_code") @db.VarChar(64)
  name           String             @db.VarChar(120)
  type           StageType
  sortOrder      Int                @default(0) @map("sort_order")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tournament     Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  groups         TournamentGroup[]
  rounds         CompetitionRound[]
  matches        Match[]

  @@unique([tournamentId, stageCode], map: "tournament_stages_tournament_id_stage_code_key")
  @@index([organizationId, tournamentId, sortOrder], map: "tournament_stages_organization_id_tournament_id_sort_order_idx")
  @@map("tournament_stages")
}

model TournamentGroup {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  stageId        String   @map("stage_id") @db.Uuid
  groupCode      String   @map("group_code") @db.VarChar(64)
  name           String   @db.VarChar(120)
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  stage          Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  matches        Match[]

  @@unique([stageId, groupCode], map: "tournament_groups_stage_id_group_code_key")
  @@index([organizationId, stageId, sortOrder], map: "tournament_groups_organization_id_stage_id_sort_order_idx")
  @@map("tournament_groups")
}

model CompetitionRound {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  stageId        String   @map("stage_id") @db.Uuid
  roundNumber    Int      @map("round_number")
  name           String   @db.VarChar(120)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  stage          Stage    @relation(fields: [stageId], references: [id], onDelete: Restrict)
  matches        Match[]

  @@unique([stageId, roundNumber], map: "competition_rounds_stage_id_round_number_key")
  @@index([organizationId, stageId, roundNumber], map: "competition_rounds_organization_id_stage_id_round_number_idx")
  @@map("competition_rounds")
}

model Team {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  teamCode        String             @map("team_code") @db.VarChar(64)
  name            String             @db.VarChar(160)
  shortName       String?            @map("short_name") @db.VarChar(80)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  homeMatches     Match[]            @relation("MatchHomeTeam")
  awayMatches     Match[]            @relation("MatchAwayTeam")
  registrations   TeamRegistration[]
  rosterSnapshots RosterSnapshot[]

  @@unique([organizationId, teamCode], map: "teams_organization_id_team_code_key")
  @@unique([id, organizationId], map: "teams_id_organization_id_key")
  @@index([organizationId, name], map: "teams_organization_id_name_idx")
  @@map("teams")
}

model PlayerProfile {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  sourceType      String?               @map("source_type") @db.VarChar(64)
  sourceKey       String?               @map("source_key") @db.VarChar(120)
  displayName     String                @map("display_name") @db.VarChar(120)
  jerseyName      String?               @map("jersey_name") @db.VarChar(120)
  studentIdMasked String?               @map("student_id_masked") @db.VarChar(64)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterEntries   RosterEntry[]
  snapshotEntries RosterSnapshotEntry[]

  // PostgreSQL partial uniqueness for non-null source_key is enforced by migration SQL.
  @@unique([id, organizationId], map: "player_profiles_id_organization_id_key")
  @@index([organizationId, displayName], map: "player_profiles_organization_id_display_name_idx")
  @@map("player_profiles")
}

model Venue {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  venueCode      String       @map("venue_code") @db.VarChar(64)
  name           String       @db.VarChar(160)
  address        String?      @db.VarChar(240)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  matches        Match[]

  @@unique([organizationId, venueCode], map: "venues_organization_id_venue_code_key")
  @@index([organizationId, name], map: "venues_organization_id_name_idx")
  @@map("venues")
}

model SchedulePlan {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  tournamentId   String             @map("tournament_id") @db.Uuid
  name           String             @db.VarChar(160)
  status         SchedulePlanStatus @default(DRAFT)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  publishedAt    DateTime?          @map("published_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournament     Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  revisions      ScheduleRevision[]
  matches        Match[]

  @@index([organizationId, tournamentId, status], map: "schedule_plans_organization_id_tournament_id_status_idx")
  @@map("schedule_plans")
}

model ScheduleRevision {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  tournamentId   String                 @map("tournament_id") @db.Uuid
  schedulePlanId String                 @map("schedule_plan_id") @db.Uuid
  version        Int
  status         ScheduleRevisionStatus @default(PUBLISHED)
  snapshot       Json                   @db.JsonB
  publishedAt    DateTime               @default(now()) @map("published_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournament     Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  schedulePlan   SchedulePlan           @relation(fields: [schedulePlanId], references: [id], onDelete: Restrict)
  matches        Match[]

  @@unique([schedulePlanId, version], map: "schedule_revisions_schedule_plan_id_version_key")
  @@index([organizationId, tournamentId, publishedAt], map: "schedule_revisions_org_tournament_published_at_idx")
  @@map("schedule_revisions")
}

model Match {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  tournamentId       String            @map("tournament_id") @db.Uuid
  schedulePlanId     String?           @map("schedule_plan_id") @db.Uuid
  scheduleRevisionId String?           @map("schedule_revision_id") @db.Uuid
  stageId            String?           @map("stage_id") @db.Uuid
  groupId            String?           @map("group_id") @db.Uuid
  roundId            String?           @map("round_id") @db.Uuid
  homeTeamId         String?           @map("home_team_id") @db.Uuid
  awayTeamId         String?           @map("away_team_id") @db.Uuid
  venueId            String?           @map("venue_id") @db.Uuid
  matchCode          String            @map("match_code") @db.VarChar(64)
  title              String            @db.VarChar(160)
  status             MatchStatus       @default(DRAFT)
  scheduledStartAt   DateTime?         @map("scheduled_start_at") @db.Timestamptz(3)
  sortOrder          Int               @default(0) @map("sort_order")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournament         Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Restrict)
  schedulePlan       SchedulePlan?     @relation(fields: [schedulePlanId], references: [id], onDelete: SetNull)
  scheduleRevision   ScheduleRevision? @relation(fields: [scheduleRevisionId], references: [id], onDelete: SetNull)
  stage              Stage?            @relation(fields: [stageId], references: [id], onDelete: SetNull)
  group              TournamentGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  round              CompetitionRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  homeTeam           Team?             @relation("MatchHomeTeam", fields: [homeTeamId], references: [id], onDelete: SetNull)
  awayTeam           Team?             @relation("MatchAwayTeam", fields: [awayTeamId], references: [id], onDelete: SetNull)
  venue              Venue?            @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@unique([organizationId, matchCode], map: "matches_organization_id_match_code_key")
  @@index([organizationId, scheduledStartAt], map: "matches_organization_id_scheduled_start_at_idx")
  @@index([tournamentId, status, scheduledStartAt], map: "matches_tournament_id_status_scheduled_start_at_idx")
  @@index([stageId, roundId], map: "matches_stage_id_round_id_idx")
  @@index([scheduleRevisionId, scheduledStartAt], map: "matches_schedule_revision_id_scheduled_start_at_idx")
  @@map("matches")
}

model TeamRegistration {
  id                String                 @id @default(uuid()) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  tournamentId      String                 @map("tournament_id") @db.Uuid
  teamId            String                 @map("team_id") @db.Uuid
  status            TeamRegistrationStatus @default(DRAFT)
  leaderDisplayName String?                @map("leader_display_name") @db.VarChar(120)
  coachDisplayName  String?                @map("coach_display_name") @db.VarChar(120)
  contactName       String?                @map("contact_name") @db.VarChar(120)
  contactPhone      String?                @map("contact_phone") @db.VarChar(40)
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournament        Tournament             @relation(fields: [tournamentId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "team_registrations_tournament_organization_fkey")
  team              Team                   @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "team_registrations_team_organization_fkey")
  rosterSubmissions RosterSubmission[]
  rosterSnapshots   RosterSnapshot[]
  importBatches     ImportBatch[]

  @@unique([tournamentId, teamId], map: "team_registrations_tournament_id_team_id_key")
  @@unique([id, organizationId], map: "team_registrations_id_organization_id_key")
  @@index([organizationId, tournamentId, status], map: "team_registrations_org_tournament_status_idx")
  @@index([organizationId, teamId], map: "team_registrations_organization_id_team_id_idx")
  @@map("team_registrations")
}

model RosterSubmission {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  teamRegistrationId String                 @map("team_registration_id") @db.Uuid
  submissionVersion  Int                    @map("submission_version")
  status             RosterSubmissionStatus @default(DRAFT)
  dataQualityStatus  DataQualityStatus      @default(CLEAN) @map("data_quality_status")
  warningCodes       String[]               @default([]) @map("warning_codes")
  sourceFileHash     String                 @map("source_file_hash") @db.Char(64)
  submittedAt        DateTime?              @map("submitted_at") @db.Timestamptz(3)
  approvedAt         DateTime?              @map("approved_at") @db.Timestamptz(3)
  lockedAt           DateTime?              @map("locked_at") @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teamRegistration   TeamRegistration       @relation(fields: [teamRegistrationId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_submissions_registration_organization_fkey")
  entries            RosterEntry[]
  snapshot           RosterSnapshot?

  @@unique([teamRegistrationId, submissionVersion], map: "roster_submissions_registration_id_version_key")
  @@unique([teamRegistrationId, sourceFileHash], map: "roster_submissions_registration_id_source_hash_key")
  @@unique([id, organizationId], map: "roster_submissions_id_organization_id_key")
  @@index([organizationId, status, createdAt], map: "roster_submissions_organization_id_status_created_at_idx")
  @@index([teamRegistrationId, status], map: "roster_submissions_registration_id_status_idx")
  @@map("roster_submissions")
}

model RosterEntry {
  id                 String           @id @default(uuid()) @db.Uuid
  organizationId     String           @map("organization_id") @db.Uuid
  rosterSubmissionId String           @map("roster_submission_id") @db.Uuid
  playerProfileId    String           @map("player_profile_id") @db.Uuid
  shirtNumber        String?          @map("shirt_number") @db.VarChar(16)
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterSubmission   RosterSubmission @relation(fields: [rosterSubmissionId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_entries_submission_organization_fkey")
  playerProfile      PlayerProfile    @relation(fields: [playerProfileId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_entries_player_organization_fkey")

  @@unique([rosterSubmissionId, playerProfileId], map: "roster_entries_submission_id_player_profile_id_key")
  @@index([organizationId, playerProfileId, rosterSubmissionId], map: "roster_entries_org_player_submission_idx")
  @@map("roster_entries")
}

model RosterSnapshot {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  tournamentId       String                @map("tournament_id") @db.Uuid
  teamId             String                @map("team_id") @db.Uuid
  teamRegistrationId String                @map("team_registration_id") @db.Uuid
  rosterSubmissionId String                @unique(map: "roster_snapshots_roster_submission_id_key") @map("roster_submission_id") @db.Uuid
  snapshotVersion    Int                   @map("snapshot_version")
  sourceFileHash     String                @map("source_file_hash") @db.Char(64)
  lockedAt           DateTime?             @map("locked_at") @db.Timestamptz(3)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournament         Tournament            @relation(fields: [tournamentId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_snapshots_tournament_organization_fkey")
  team               Team                  @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_snapshots_team_organization_fkey")
  teamRegistration   TeamRegistration      @relation(fields: [teamRegistrationId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_snapshots_registration_organization_fkey")
  rosterSubmission   RosterSubmission      @relation(fields: [rosterSubmissionId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_snapshots_submission_organization_fkey")
  entries            RosterSnapshotEntry[]
  importBatches      ImportBatch[]

  @@unique([tournamentId, teamId, snapshotVersion], map: "roster_snapshots_tournament_id_team_id_version_key")
  @@unique([rosterSubmissionId, organizationId], map: "roster_snapshots_submission_id_organization_id_key")
  @@unique([id, organizationId], map: "roster_snapshots_id_organization_id_key")
  @@index([organizationId, tournamentId, teamId, lockedAt], map: "roster_snapshots_org_tournament_team_locked_at_idx")
  @@index([teamRegistrationId, snapshotVersion], map: "roster_snapshots_registration_id_version_idx")
  @@map("roster_snapshots")
}

model RosterSnapshotEntry {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  rosterSnapshotId String         @map("roster_snapshot_id") @db.Uuid
  playerProfileId  String         @map("player_profile_id") @db.Uuid
  displayName      String         @map("display_name") @db.VarChar(120)
  shirtNumber      String?        @map("shirt_number") @db.VarChar(16)
  studentIdMasked  String?        @map("student_id_masked") @db.VarChar(64)
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rosterSnapshot   RosterSnapshot @relation(fields: [rosterSnapshotId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_snapshot_entries_snapshot_organization_fkey")
  playerProfile    PlayerProfile  @relation(fields: [playerProfileId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "roster_snapshot_entries_player_organization_fkey")

  @@unique([rosterSnapshotId, playerProfileId], map: "roster_snapshot_entries_snapshot_id_player_id_key")
  @@index([organizationId, rosterSnapshotId, sortOrder], map: "roster_snapshot_entries_org_snapshot_sort_idx")
  @@map("roster_snapshot_entries")
}

model ImportBatch {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  tournamentId       String            @map("tournament_id") @db.Uuid
  teamRegistrationId String?           @map("team_registration_id") @db.Uuid
  rosterSnapshotId   String?           @map("roster_snapshot_id") @db.Uuid
  importType         String            @map("import_type") @db.VarChar(64)
  schemaVersion      Int               @map("schema_version")
  sourceFileHash     String            @map("source_file_hash") @db.Char(64)
  status             ImportBatchStatus @default(UPLOADED)
  teamCode           String            @map("team_code") @db.VarChar(64)
  rowCount           Int               @map("row_count")
  warningCodes       String[]          @default([]) @map("warning_codes")
  confirmedAt        DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tournament         Tournament        @relation(fields: [tournamentId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "import_batches_tournament_organization_fkey")
  teamRegistration   TeamRegistration? @relation(fields: [teamRegistrationId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "import_batches_registration_organization_fkey")
  rosterSnapshot     RosterSnapshot?   @relation(fields: [rosterSnapshotId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "import_batches_snapshot_organization_fkey")

  @@unique([organizationId, tournamentId, importType, sourceFileHash], map: "import_batches_org_tournament_type_source_hash_key")
  @@index([organizationId, tournamentId, createdAt], map: "import_batches_org_tournament_created_at_idx")
  @@index([teamRegistrationId, createdAt], map: "import_batches_registration_id_created_at_idx")
  @@map("import_batches")
}
