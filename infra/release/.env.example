# Copy to .env on the target host. Never commit .env or rendered Compose secrets.
COMPOSE_PROJECT_NAME=xiaoqiu-release
APP_VERSION=replace-with-reviewed-git-commit

# Fixed repository/CI baseline; test security patch upgrades before changing pins.
NODE_IMAGE=node:22.14.0-bookworm-slim
PNPM_VERSION=11.5.2
POSTGRES_IMAGE=postgres:17.4-bookworm
NGINX_IMAGE=nginx:1.27.4-alpine
CADDY_IMAGE=caddy:2.10.2-alpine

POSTGRES_USER=xiaoqiu
POSTGRES_DB=xiaoqiu_release
# Required. Generate locally with openssl rand -hex 32; hex avoids URL encoding.
POSTGRES_PASSWORD=

# UUIDs returned by bootstrap / the authorized management UI, never demo IDs.
DEFAULT_ORGANIZATION_ID=
DEFAULT_TOURNAMENT_ID=

# Exact browser origins, separated by commas; no paths or wildcard.
CORS_ORIGINS=https://xiaoqiu-h5-trial.gb-physics.chatgpt.site,https://admin.example.invalid
# Admin build-time URL includes /api. H5 TARO_APP_API_BASE_URL excludes /api.
VITE_API_BASE_URL=https://api.example.invalid/api
API_BIND_PORT=3101
ADMIN_BIND_PORT=5180

# Optional edge profile; set real domains/email only at the deployment step.
API_DOMAIN=api.example.invalid
ADMIN_DOMAIN=admin.example.invalid
ACME_EMAIL=operator@example.invalid

WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
WORKER_LEASE_MS=30000
WORKER_TRANSACTION_TIMEOUT_MS=10000
WORKER_RETRY_BASE_MS=250
WORKER_RETRY_MAX_MS=60000
